# AWIS-HM Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- Application ---
DEBUG=false
HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Image quality thresholds (two-tier: fail / warn) ---
# These are configurable provisional values — not scientifically validated limits.
# Each metric has a FAIL tier (genuinely unusable) and a WARNING tier (imperfect but usable).
QUALITY_BLUR_THRESHOLD_FAIL=15.0
QUALITY_BLUR_THRESHOLD_WARN=50.0
QUALITY_MIN_WIDTH=640
QUALITY_MIN_HEIGHT=480
QUALITY_MAX_FILE_MB=20.0
QUALITY_BRIGHTNESS_LOW_FAIL=25.0
QUALITY_BRIGHTNESS_LOW_WARN=50.0
QUALITY_BRIGHTNESS_HIGH_WARN=220.0
QUALITY_BRIGHTNESS_HIGH_FAIL=240.0
QUALITY_CONTRAST_MIN_FAIL=5.0
QUALITY_CONTRAST_MIN_WARN=15.0

# --- Storage ---
UPLOAD_DIR=uploads

# --- YOLOv8 segmentation (Milestone 3) ---
# Set this to a trained YOLOv8-seg checkpoint. No predictions are generated
# while it is missing. A public crack model may be used only for prototype tests.
MODEL_PATH=models/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_IMAGE_SIZE=640

# --- Physical calibration (Milestone 5) ---
# Include a real ArUco marker printed/measured to this physical size in each image.
CALIBRATION_MARKER_SIZE_MM=50.0
CALIBRATION_DICTIONARY=DICT_4X4_50
CALIBRATION_MIN_MARKER_SIDE_PX=20.0

# --- Visible surface condition assessment (project-defined prototype thresholds) ---
CONDITION_UNCALIBRATED_SUPPORTED=true
CONDITION_WIDTH_MODERATE_MM=1.0
CONDITION_WIDTH_SEVERE_MM=3.0
CONDITION_AREA_MODERATE_MM2=500.0
CONDITION_AREA_SEVERE_MM2=2000.0
CONDITION_LENGTH_MODERATE_MM=100.0
CONDITION_LENGTH_SEVERE_MM=500.0
CONDITION_WIDTH_MODERATE_PX=3.0
CONDITION_WIDTH_SEVERE_PX=10.0
CONDITION_AREA_MODERATE_PX2=1000.0
CONDITION_AREA_SEVERE_PX2=5000.0
CONDITION_LENGTH_MODERATE_PX=100.0
CONDITION_LENGTH_SEVERE_PX=500.0
CONDITION_CONFIDENCE_HIGH=0.75
CONDITION_CONFIDENCE_LOW=0.50
CONDITION_MILD_MIN_SCORE=7.5
CONDITION_MODERATE_MIN_SCORE=4.0

# --- External APIs (Milestone 7 — not required for Milestone 1) ---
EMBEDDING_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_MODEL=

LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.1
